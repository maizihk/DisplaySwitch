{
  "schemaVersion": 1,
  "protocolVersion": 2,
  "vectors": [
    {
      "id": "P-001", "description": "Authenticated status probe returns the same event ID and has zero hardware effects",
      "initialState": { "localEndpointID": "11111111-1111-4111-8111-111111111111", "coordinationEnabled": true, "state": "idle", "activeEventID": null, "lockedTargetEndpointID": null, "enabledTargets": [] },
      "steps": [{ "atMs": 0, "input": { "kind": "statusProbe", "endpointID": "22222222-2222-4222-8222-222222222222", "eventID": "10000000-0000-4000-8000-000000000001", "authenticated": true } }],
      "expectedActions": [{ "atMs": 0, "kind": "setPeerReachable", "value": true }, { "atMs": 0, "kind": "sendMessage", "type": "status_response", "eventID": "10000000-0000-4000-8000-000000000001", "endpointID": "22222222-2222-4222-8222-222222222222" }],
      "expectedHardwareCalls": { "wake": 0, "switchDisplay": 0, "inputActions": 0 }, "finalState": { "state": "idle", "activeEventID": null, "lockedTargetEndpointID": null }
    },
    {
      "id": "P-002", "description": "Manual selection sends only to the selected endpoint and switches after target-ready",
      "initialState": { "localEndpointID": "11111111-1111-4111-8111-111111111111", "coordinationEnabled": true, "state": "idle", "activeEventID": null, "lockedTargetEndpointID": null, "enabledTargets": [{ "endpointID": "22222222-2222-4222-8222-222222222222", "capability": "v2", "reachable": true }, { "endpointID": "33333333-3333-4333-8333-333333333333", "capability": "v2", "reachable": true }] },
      "steps": [{ "atMs": 0, "input": { "kind": "manualSelect", "endpointID": "22222222-2222-4222-8222-222222222222", "eventID": "20000000-0000-4000-8000-000000000002" } }, { "atMs": 100, "input": { "kind": "receiveTargetReady", "endpointID": "22222222-2222-4222-8222-222222222222", "eventID": "20000000-0000-4000-8000-000000000002", "authenticated": true, "wakeSucceeded": true } }, { "atMs": 101, "input": { "kind": "switchCompleted", "eventID": "20000000-0000-4000-8000-000000000002", "success": true } }],
      "expectedActions": [{ "atMs": 0, "kind": "lockTarget", "endpointID": "22222222-2222-4222-8222-222222222222" }, { "atMs": 0, "kind": "sendMessage", "type": "handover_request", "eventID": "20000000-0000-4000-8000-000000000002", "endpointID": "22222222-2222-4222-8222-222222222222", "intent": "manual" }, { "atMs": 100, "kind": "requestSwitch", "eventID": "20000000-0000-4000-8000-000000000002", "endpointID": "22222222-2222-4222-8222-222222222222" }, { "atMs": 101, "kind": "sendMessage", "type": "committed", "eventID": "20000000-0000-4000-8000-000000000002", "endpointID": "22222222-2222-4222-8222-222222222222", "switchSucceeded": true }, { "atMs": 101, "kind": "clearEvent" }],
      "expectedHardwareCalls": { "wake": 0, "switchDisplay": 1, "inputActions": 0 }, "finalState": { "state": "completed", "activeEventID": null, "lockedTargetEndpointID": null }
    },
    {
      "id": "P-009", "description": "Duplicate manual request and committed messages preserve at-most-once wake and idempotent completion",
      "initialState": { "localEndpointID": "22222222-2222-4222-8222-222222222222", "coordinationEnabled": true, "state": "idle", "activeEventID": null, "lockedTargetEndpointID": null, "enabledTargets": [{ "endpointID": "11111111-1111-4111-8111-111111111111", "capability": "v2", "reachable": true }] },
      "steps": [{ "atMs": 0, "input": { "kind": "receiveHandoverRequest", "endpointID": "11111111-1111-4111-8111-111111111111", "eventID": "90000000-0000-4000-8000-000000000009", "authenticated": true, "intent": "manual" } }, { "atMs": 50, "input": { "kind": "receiveHandoverRequest", "endpointID": "11111111-1111-4111-8111-111111111111", "eventID": "90000000-0000-4000-8000-000000000009", "authenticated": true, "intent": "manual" } }, { "atMs": 100, "input": { "kind": "wakeCompleted", "eventID": "90000000-0000-4000-8000-000000000009", "success": true } }, { "atMs": 200, "input": { "kind": "receiveCommitted", "endpointID": "11111111-1111-4111-8111-111111111111", "eventID": "90000000-0000-4000-8000-000000000009", "authenticated": true, "switchSucceeded": true } }, { "atMs": 250, "input": { "kind": "receiveCommitted", "endpointID": "11111111-1111-4111-8111-111111111111", "eventID": "90000000-0000-4000-8000-000000000009", "authenticated": true, "switchSucceeded": true } }],
      "expectedActions": [{ "atMs": 0, "kind": "requestWake", "eventID": "90000000-0000-4000-8000-000000000009" }, { "atMs": 50, "kind": "ignoreMessage", "reason": "duplicate", "eventID": "90000000-0000-4000-8000-000000000009" }, { "atMs": 100, "kind": "sendMessage", "type": "target_ready", "eventID": "90000000-0000-4000-8000-000000000009", "endpointID": "11111111-1111-4111-8111-111111111111", "wakeSucceeded": true }, { "atMs": 200, "kind": "clearEvent" }, { "atMs": 250, "kind": "ignoreMessage", "reason": "duplicate", "eventID": "90000000-0000-4000-8000-000000000009" }],
      "expectedHardwareCalls": { "wake": 1, "switchDisplay": 0, "inputActions": 0 }, "finalState": { "state": "completed", "activeEventID": null, "lockedTargetEndpointID": null }
    },
    {
      "id": "P-010", "description": "Configuration reload clears the active manual event and makes late ready messages harmless",
      "initialState": { "localEndpointID": "11111111-1111-4111-8111-111111111111", "coordinationEnabled": true, "state": "awaiting_ready", "activeEventID": "a0000000-0000-4000-8000-000000000010", "lockedTargetEndpointID": "22222222-2222-4222-8222-222222222222", "enabledTargets": [{ "endpointID": "22222222-2222-4222-8222-222222222222", "capability": "v2", "reachable": true }] },
      "steps": [{ "atMs": 0, "input": { "kind": "configurationChanged" } }, { "atMs": 100, "input": { "kind": "receiveTargetReady", "endpointID": "22222222-2222-4222-8222-222222222222", "eventID": "a0000000-0000-4000-8000-000000000010", "authenticated": true, "wakeSucceeded": true } }],
      "expectedActions": [{ "atMs": 0, "kind": "clearEvent", "reason": "configuration_changed" }, { "atMs": 100, "kind": "ignoreMessage", "reason": "no_pending_event", "eventID": "a0000000-0000-4000-8000-000000000010" }],
      "expectedHardwareCalls": { "wake": 0, "switchDisplay": 0, "inputActions": 0 }, "finalState": { "state": "cancelled", "activeEventID": null, "lockedTargetEndpointID": null }
    },
    {
      "id": "P-019", "description": "Manual online target keeps four 150 ms requests and falls back once at 600 ms",
      "initialState": { "localEndpointID": "11111111-1111-4111-8111-111111111111", "coordinationEnabled": true, "state": "idle", "activeEventID": null, "lockedTargetEndpointID": null, "enabledTargets": [{ "endpointID": "22222222-2222-4222-8222-222222222222", "capability": "v2", "reachable": true }] },
      "steps": [{ "atMs": 0, "input": { "kind": "manualSelect", "endpointID": "22222222-2222-4222-8222-222222222222", "eventID": "19000000-0000-4000-8000-000000000019" } }, { "atMs": 600, "input": { "kind": "advanceTime" } }],
      "expectedActions": [{ "atMs": 0, "kind": "lockTarget", "endpointID": "22222222-2222-4222-8222-222222222222" }, { "atMs": 0, "kind": "sendMessage", "type": "handover_request", "eventID": "19000000-0000-4000-8000-000000000019", "endpointID": "22222222-2222-4222-8222-222222222222", "intent": "manual" }, { "atMs": 150, "kind": "sendMessage", "type": "handover_request", "eventID": "19000000-0000-4000-8000-000000000019", "endpointID": "22222222-2222-4222-8222-222222222222", "intent": "manual" }, { "atMs": 300, "kind": "sendMessage", "type": "handover_request", "eventID": "19000000-0000-4000-8000-000000000019", "endpointID": "22222222-2222-4222-8222-222222222222", "intent": "manual" }, { "atMs": 450, "kind": "sendMessage", "type": "handover_request", "eventID": "19000000-0000-4000-8000-000000000019", "endpointID": "22222222-2222-4222-8222-222222222222", "intent": "manual" }, { "atMs": 600, "kind": "requestSwitch", "eventID": "19000000-0000-4000-8000-000000000019", "endpointID": "22222222-2222-4222-8222-222222222222" }],
      "expectedHardwareCalls": { "wake": 0, "switchDisplay": 1, "inputActions": 0 }, "finalState": { "state": "switching", "activeEventID": "19000000-0000-4000-8000-000000000019", "lockedTargetEndpointID": "22222222-2222-4222-8222-222222222222" }
    },
    {
      "id": "P-021", "description": "Authenticated wake-display requests wake once and duplicate delivery is idempotent",
      "initialState": { "localEndpointID": "22222222-2222-4222-8222-222222222222", "coordinationEnabled": true, "state": "idle", "activeEventID": null, "lockedTargetEndpointID": null, "enabledTargets": [{ "endpointID": "11111111-1111-4111-8111-111111111111", "capability": "v2", "reachable": true }] },
      "steps": [{ "atMs": 0, "input": { "kind": "receiveWakeDisplay", "endpointID": "11111111-1111-4111-8111-111111111111", "eventID": "21000000-0000-4000-8000-000000000021", "authenticated": true } }, { "atMs": 50, "input": { "kind": "receiveWakeDisplay", "endpointID": "11111111-1111-4111-8111-111111111111", "eventID": "21000000-0000-4000-8000-000000000021", "authenticated": true } }],
      "expectedActions": [{ "atMs": 0, "kind": "requestWake", "eventID": "21000000-0000-4000-8000-000000000021" }, { "atMs": 50, "kind": "ignoreMessage", "reason": "duplicate", "eventID": "21000000-0000-4000-8000-000000000021" }],
      "expectedHardwareCalls": { "wake": 1, "switchDisplay": 0, "inputActions": 0 }, "finalState": { "state": "idle", "activeEventID": null, "lockedTargetEndpointID": null }
    }
  ]
