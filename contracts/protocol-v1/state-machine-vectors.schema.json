{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://displayswitch.example/contracts/protocol-v1/state-machine-vectors.schema.json",
  "title": "DisplaySwitch protocol v1 state machine vectors",
  "type": "object",
  "required": ["schemaVersion", "protocolVersion", "referenceTime", "configuredPairingCode", "vectors"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "protocolVersion": { "type": "integer", "const": 1 },
    "referenceTime": { "type": "number" },
    "configuredPairingCode": { "type": "string", "const": "TEST-CODE-0001" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "nullableUuid": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "nullableInteger": {
      "type": ["integer", "null"]
    },
    "platform": {
      "type": "string",
      "enum": ["mac", "windows"]
    },
    "messageType": {
      "type": "string",
      "enum": [
        "handover_request",
        "usb_present",
        "usb_attached_and_awake",
        "committed",
        "status_probe",
        "status_response"
      ]
    },
    "initialState": {
      "type": "object",
      "required": [
        "localPlatform",
        "coordinationEnabled",
        "usbAutomationEnabled",
        "usbPresent",
        "peerReachable",
        "peerLastSeenAtMs",
        "incomingEventID",
        "outgoingEventID",
        "newestIncomingRequestTimestamp",
        "seenMessages",
        "nextEventIDs"
      ],
      "properties": {
        "localPlatform": { "$ref": "#/$defs/platform" },
        "coordinationEnabled": { "type": "boolean" },
        "usbAutomationEnabled": { "type": "boolean" },
        "usbPresent": { "type": "boolean" },
        "peerReachable": { "type": "boolean" },
        "peerLastSeenAtMs": { "$ref": "#/$defs/nullableInteger" },
        "incomingEventID": { "$ref": "#/$defs/nullableUuid" },
        "outgoingEventID": { "$ref": "#/$defs/nullableUuid" },
        "newestIncomingRequestTimestamp": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "seenMessages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "eventID", "seenAtMs"],
            "properties": {
              "type": { "$ref": "#/$defs/messageType" },
              "eventID": { "$ref": "#/$defs/uuid" },
              "seenAtMs": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "nextEventIDs": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" }
        }
      },
      "additionalProperties": false
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "present"],
          "properties": {
            "kind": { "const": "usbPresenceChanged" },
            "present": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "message"],
          "properties": {
            "kind": { "const": "receiveMessage" },
            "message": { "$ref": "message.schema.json" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "eventID", "success"],
          "properties": {
            "kind": { "const": "wakeCompleted" },
            "eventID": { "$ref": "#/$defs/uuid" },
            "success": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "eventID", "success"],
          "properties": {
            "kind": { "const": "switchCompleted" },
            "eventID": { "$ref": "#/$defs/uuid" },
            "success": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "enabled"],
          "properties": {
            "kind": { "const": "coordinationChanged" },
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "advanceTime" }
          },
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["atMs", "input"],
      "properties": {
        "atMs": { "type": "integer", "minimum": 0 },
        "input": { "$ref": "#/$defs/input" }
      },
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["atMs", "kind", "type", "eventID"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "acceptMessage" },
            "type": { "$ref": "#/$defs/messageType" },
            "eventID": { "$ref": "#/$defs/uuid" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atMs", "kind", "reason"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "rejectMessage" },
            "reason": {
              "type": "string",
              "enum": ["duplicate", "out_of_order", "stale_event", "invalid_message", "no_pending_event"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atMs", "kind", "type", "eventID"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "sendMessage" },
            "type": { "$ref": "#/$defs/messageType" },
            "eventID": { "$ref": "#/$defs/uuid" },
            "wakeSucceeded": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atMs", "kind", "type", "eventID", "count"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "sendBurst" },
            "type": {
              "type": "string",
              "enum": ["usb_present", "usb_attached_and_awake"]
            },
            "eventID": { "$ref": "#/$defs/uuid" },
            "count": { "type": "integer", "const": 3 },
            "wakeSucceeded": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atMs", "kind", "eventID"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "requestWake" },
            "eventID": { "$ref": "#/$defs/uuid" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atMs", "kind", "eventID"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "requestSwitch" },
            "eventID": { "$ref": "#/$defs/uuid" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atMs", "kind", "value"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "setPeerReachable" },
            "value": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["atMs", "kind", "eventID"],
          "properties": {
            "atMs": { "type": "integer", "minimum": 0 },
            "kind": { "const": "cancelOutgoing" },
            "eventID": { "$ref": "#/$defs/uuid" }
          },
          "additionalProperties": false
        }
      ]
    },
    "hardwareCalls": {
      "type": "object",
      "required": ["wake", "switchDisplay", "usbActions"],
      "properties": {
        "wake": { "type": "integer", "minimum": 0 },
        "switchDisplay": { "type": "integer", "minimum": 0 },
        "usbActions": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "finalState": {
      "type": "object",
      "required": [
        "coordinationEnabled",
        "usbPresent",
        "peerReachable",
        "peerLastSeenAtMs",
        "incomingEventID",
        "outgoingEventID"
      ],
      "properties": {
        "coordinationEnabled": { "type": "boolean" },
        "usbPresent": { "type": "boolean" },
        "peerReachable": { "type": "boolean" },
        "peerLastSeenAtMs": { "$ref": "#/$defs/nullableInteger" },
        "incomingEventID": { "$ref": "#/$defs/nullableUuid" },
        "outgoingEventID": { "$ref": "#/$defs/nullableUuid" },
        "newestIncomingRequestTimestamp": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "seenMessageCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "vector": {
      "type": "object",
      "required": ["id", "description", "initialState", "steps", "expectedActions", "expectedHardwareCalls", "finalState"],
      "properties": {
        "id": { "type": "string", "pattern": "^SM-[0-9]{3}$" },
        "description": { "type": "string", "minLength": 1 },
        "initialState": { "$ref": "#/$defs/initialState" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "expectedActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "expectedHardwareCalls": { "$ref": "#/$defs/hardwareCalls" },
        "finalState": { "$ref": "#/$defs/finalState" }
      },
      "additionalProperties": false
    }
  }
}
