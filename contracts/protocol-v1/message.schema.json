{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://displayswitch.example/contracts/protocol-v1/message.schema.json",
  "title": "DisplaySwitch UDP protocol v1 message",
  "type": "object",
  "required": [
    "version",
    "type",
    "eventID",
    "source",
    "target",
    "timestamp",
    "pairingCode"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "handover_request",
        "usb_present",
        "usb_attached_and_awake",
        "committed",
        "status_probe",
        "status_response"
      ]
    },
    "eventID": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "source": {
      "type": "string",
      "enum": ["mac", "windows"]
    },
    "target": {
      "type": "string",
      "enum": ["mac", "windows"]
    },
    "timestamp": {
      "type": "number"
    },
    "pairingCode": {
      "type": "string",
      "minLength": 8
    },
    "wakeSucceeded": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "source": { "const": "mac" },
        "target": { "const": "windows" }
      }
    },
    {
      "properties": {
        "source": { "const": "windows" },
        "target": { "const": "mac" }
      }
    }
  ],
  "additionalProperties": true
}
